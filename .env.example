# Copy to .env and fill in. Bun loads .env automatically. Never commit .env.

# development | test | production
NODE_ENV=development
PORT=3001

# Runtime connection, as the velio_api role (local Postgres from infra/docker-compose.yml).
DATABASE_URL=postgres://velio_api@localhost:5432/velio
# Direct, unpooled connection for LISTEN (used from S3).
DATABASE_LISTEN_URL=postgres://velio_api@localhost:5432/velio

# Server secret that keys contact hashes (at least 32 characters).
# Generate: openssl rand -base64 48
CONTACT_PEPPER=

# CloudFront's X-Origin-Verify secret (at least 32 characters). Required and enforced only when NODE_ENV=production.
ORIGIN_VERIFY_SECRET=

# OTLP/HTTP collector. Leave empty to disable telemetry export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Session lifetimes (S1 PLANNING §4.4).
SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=90

# --- Tokens for operations (optional, local only) ---
# Grafana Cloud OTLP (S10 T6): stack → Connections → OpenTelemetry (OTLP).
# Token: an access-policy token with only metrics:write, logs:write and traces:write.
# Stored in AWS with the command under "Grafana Cloud" in README.md.
GRAFANA_OTLP_ENDPOINT=
GRAFANA_INSTANCE_ID=
GRAFANA_API_TOKEN=
