{
  "uid": "velio-booking-realtime",
  "title": "Velio · Booking and realtime",
  "description": "Booking engine and live-update health (MVP plan §4.12). Production only: local data carries deployment_environment=\"development\".",
  "tags": ["velio"],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Booking duration p95 by path",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(booking_duration_seconds_bucket{deployment_environment!=\"development\"}[5m])))",
          "legendFormat": "{{path}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Spot row wait p95 (R2)",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROM}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(booking_row_wait_seconds_bucket{deployment_environment!=\"development\"}[5m])))",
          "legendFormat": "row wait",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Attempts by path and outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "sum by (path, outcome) (rate(booking_attempts_total{deployment_environment!=\"development\"}[5m]))",
          "legendFormat": "{{path}} {{outcome}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Open sockets by platform",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROM}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "sum by (platform) (realtime_open_sockets{deployment_environment!=\"development\"})",
          "legendFormat": "{{platform}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Notify lag p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(realtime_notify_lag_seconds_bucket{deployment_environment!=\"development\"}[5m])))",
          "legendFormat": "commit → listener",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Reconnects",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROM}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "sum by (platform) (rate(realtime_reconnects_total{deployment_environment!=\"development\"}[5m]))",
          "legendFormat": "{{platform}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "sum(rate(realtime_listener_reconnects_total{deployment_environment!=\"development\"}[5m]))",
          "legendFormat": "listener",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
