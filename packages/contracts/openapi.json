{
  "openapi": "3.1.0",
  "info": {
    "title": "Velio API",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "velio_session"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/MemberPerson"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "user"
        ]
      },
      "MemberPerson": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "shortName": {
            "type": "string",
            "example": "Tunde A."
          },
          "avatarSeed": {
            "type": "string"
          },
          "displayName": {
            "type": "string",
            "example": "Tunde Adeyemi"
          }
        },
        "required": [
          "id",
          "shortName",
          "avatarSeed",
          "displayName"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "sold_out",
          "already_booked",
          "already_claimed",
          "invite_expired",
          "invite_paused",
          "activity_started",
          "bookings_paused",
          "invalid_code",
          "rate_limited",
          "location_locked",
          "invalid_contact",
          "validation_failed",
          "unauthenticated",
          "forbidden",
          "not_found",
          "internal"
        ]
      },
      "SessionCreate": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "contact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 254
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        },
        "required": [
          "displayName",
          "contact"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/healthz": {
      "get": {
        "summary": "Liveness. Never touches the database.",
        "responses": {
          "200": {
            "description": "The process is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/readyz": {
      "get": {
        "summary": "Readiness. 200 only when a database query succeeds.",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions": {
      "post": {
        "summary": "Continue as: sign in or sign up with a name and an email or phone",
        "description": "Always issues a new session and revokes any session sent with the request. Web clients get an httpOnly cookie; clients sending `X-Client: mobile` get the token in the body.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "web",
                "mobile"
              ]
            },
            "required": false,
            "name": "x-client",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "required": false,
            "name": "x-device-id",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_contact` or `validation_failed`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "summary": "The signed-in person",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The caller",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberPerson"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/current": {
      "delete": {
        "summary": "Sign out: revoke the current session",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "description": "`unauthenticated`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
